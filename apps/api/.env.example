# Em local as duas apontam para o mesmo Postgres. No Neon: DATABASE_URL = ligação com pooler (host "-pooler"),
# DIRECT_URL = ligação direta (usada pelas migrações).
DATABASE_URL="postgresql://schedule:schedule@localhost:5432/schedule"
DIRECT_URL="postgresql://schedule:schedule@localhost:5432/schedule"
WEB_ORIGIN="http://localhost:5173"
PORT=3000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# Email (recuperação de palavra-passe). "console" imprime o link no terminal da API.
MAIL_TRANSPORT=console
# MAIL_TRANSPORT=resend
# RESEND_API_KEY=re_xxx
# MAIL_FROM="Horários <no-reply@o-seu-dominio.pt>"
