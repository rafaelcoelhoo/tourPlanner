{
  "name": "@schedule/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc -p .",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "seed:admin": "tsx prisma/seed-admin.ts",
    "build": "prisma generate",
    "start:prod": "prisma migrate deploy && tsx src/server.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^11.2.1",
    "@prisma/client": "^5.22.0",
    "@schedule/core": "*",
    "argon2": "^0.41.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
